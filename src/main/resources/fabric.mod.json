{
  "schemaVersion": 1,
  "id": "amphora",
  "version": "${version}",
  "name": "Amphora",
  "description": "This is an example description! Tell everyone what your mod is about!",
  "authors": [
    "Peyrlac"
  ],
  "contact": {
    "sources": "https://github.com/Fabricators-of-Create/create-fabric-addon-template"
  },
  "license": "CC0",
  "icon": "assets/amphora/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "be.pierrelac.amphora.Amphora"
    ],
    "client": [
      "be.pierrelac.amphora.AmphoraClient"
    ],
    "emi": [
      "be.pierrelac.amphora.compat.emi.AmphoraEmiPlugin"
    ]
  },
  "mixins": [
    "amphora.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "create": "${create_version}",
    "vinery": "*",
    "emi": "*"
  }
}
